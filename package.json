{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "src/server.js",
  "imports": {
    "#generated/*": "./generated/*",
    "#config": "./src/config/config.js",
    "#db/*": "./src/db/*",
    "#errors": "./src/errors/index.js",
    "#middlewares": "./src/middlewares/index.js",
    "#repositories": "./src/repositories/index.js"
  },
  "scripts": {
    "prod": "node src/server.js",
    "dev": "node --env-file=./env/.env.development --watch src/server.js",
    "prisma:generate": "dotenv -e ./env/.env.development -- npx prisma generate",
    "prisma:migrate": "dotenv -e ./env/.env.development -- npx prisma migrate dev",
    "prisma:reset": "dotenv -e ./env/.env.development -- npx prisma migrate reset",
    "seed": "node --env-file=./env/.env.development ./scripts/seed.js --allow-reset=panda_market",
    "lint": "eslint \"src/**/*.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "mongoose": "^9.9.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0"
  }
}
